# name: test/sql/smoke.test
# description: Smoke tests for the `aba` native extension.
# group: [aba]

require aba

# Valid ABA numbers (weighted checksum passes).
query I
SELECT aba_validate('021000021');
----
true

query I
SELECT aba_validate('322271627');
----
true

# Invalid checksum.
query I
SELECT aba_validate('021000020');
----
false

# Non-digits or wrong length.
query I
SELECT aba_validate('not-nine-digits');
----
false

query I
SELECT aba_validate('12345');
----
false

# FRB district lookup.
query I
SELECT aba_frb_district('021000021');
----
2

query I
SELECT aba_frb_district('322271627');
----
12

# Unrecognized prefix -> NULL.
query I
SELECT aba_frb_district('999999999');
----
NULL

# Region names.
query I
SELECT aba_fed_region('021000021');
----
New York

query I
SELECT aba_fed_region('322271627');
----
San Francisco

# NULL propagation on unrecognized prefix.
query I
SELECT aba_fed_region('999999999');
----
NULL
