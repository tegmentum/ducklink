package duckdb:extension@5.0.0;

use runtime;
use callback-dispatch;
use config;
use logging;
use catalog;
use files;
use guest;
use storage;
use storage-dispatch;
use storage-write-dispatch;

world duckdb-extension {
  import runtime;
  import config;
  import logging;
  import catalog;
  import files;
  export guest;
  export callback-dispatch;
}

// Storage-capable world targeted by this scanner: additionally imports the
// storage registration surface and exports the storage-dispatch callbacks.
world duckdb-extension-storage {
  import runtime;
  import config;
  import logging;
  import catalog;
  import files;
  import storage;
  export guest;
  export callback-dispatch;
  export storage-dispatch;
}

// Writable-storage world (2.1.0): additionally exports storage-write-dispatch
// on top of the read-only storage-dispatch. The host instantiates its bindings
// lazily -- read-only backends satisfy `duckdb-extension-storage` and never
// touch the write-side.
world duckdb-extension-storage-write {
  import runtime;
  import config;
  import logging;
  import catalog;
  import files;
  import storage;
  export guest;
  export callback-dispatch;
  export storage-dispatch;
  export storage-write-dispatch;
}
