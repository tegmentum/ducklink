{
  "name": "duckdb-component-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Boot the DuckLink core wasip2 component in the browser via @tegmentum/wasmos-browser + @wasmos/runtime-guest-bridge (wasm-cm's portable runtime-guest driver, no jco). JS bindings generated by wit-js-bindgen --role runtime-guest from the built ducklink_core.wasm.",
  "scripts": {
    "generate": "bash generate.sh",
    "copy-wasm": "bash copy-wasm.sh",
    "predev": "npm run copy-wasm",
    "dev": "vite",
    "verify": "npm run copy-wasm && node verify.mjs",
    "verify-prepared": "npm run copy-wasm && node verify.mjs /index-prepared.html",
    "verify-tvm-spill": "npm run copy-wasm && node verify.mjs /index-tvm.html",
    "verify-ext": "npm run copy-wasm && node verify.mjs /index-ext.html",
    "verify-aba": "npm run copy-wasm && node verify.mjs /index-aba.html",
    "verify-cron": "npm run copy-wasm && node verify.mjs /index-cron.html",
    "test-tvm-host": "node tvm-host.test.mjs"
  },
  "dependencies": {
    "@tegmentum/wasi-polyfill": "file:../../wasi-polyfill",
    "@tegmentum/wasmos-browser": "file:../../wit-js-bindgen/examples/wasmos-browser",
    "@wasmos/runtime-guest-bridge": "file:../../elena-wasm/packages/runtime-guest-bridge",
    "apache-arrow": "^17.0.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "vite": "^7.0.0"
  }
}
