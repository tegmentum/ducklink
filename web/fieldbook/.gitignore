# Generated by `npm install` / `npm run build`. Rebuild via `make fieldbook-browser`.
node_modules/
package-lock.json

# Vite's build output. Unlike the mosaic-browser sibling, the fieldbook
# dist/ is NOT committed: it includes ~10 MB of jco's transpiler wasm plus
# the ~45 MB DuckDB core and the ~230 KB fieldbook.wasm — impractical to
# ship in-tree. `make fieldbook-browser` regenerates everything from
# source in ~10 s once node_modules is warm.
dist/
