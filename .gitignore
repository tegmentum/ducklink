test/fixtures/aws/

# local R2 publish credentials (never commit)
r2.env

# regenerable bench-bridge output
/bridges/

# wkg (WIT package manager) lockfile — regenerated by wkg; empty when no WIT deps
wkg.lock

# wit-bindgen stale output: real bindings are generated inline via
