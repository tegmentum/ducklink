package duckdb:loader-stub;

// A no-op provider for the three host imports the core component declares for
// dynamic extension loading. The standalone (wac-composed) deployment cannot
// instantiate extension components at runtime, so it links this stub instead of
// the native host: `request-load` always declines, no registrations are ever
// pending, and the callback-dispatch entry points are never reached (nothing is
// registered to invoke them). Plain SQL works; `LOAD <ext>` simply reports the
// extension is unavailable.
//
// At `duckdb:extension@5.0.0` the eight `*-host` interfaces (storage-host,
// index-host, collation-host, pragma-host, parser-host, optimizer-host,
// files-host, table-stream-host) are gone: the wasm core no longer participates
// in the storage / index / files pipeline, so the loader-stub no longer needs
// to export any `*-host` shim.
world loader-stub {
    export duckdb:component/host-extension-loader;
    export duckdb:component/extension-loader-hooks;
    export duckdb:extension/callback-dispatch@5.0.0;
    // The core imports tvm:memory unconditionally (the >4 GiB spill tier). The
    // standalone has no 64-bit host to back it, so the stub declines region
    // creation: the guest's spill bridge then disables TVM and falls back to
    // the ordinary temp-directory path. (A future spill-capable standalone
    // could back regions with the stub's own linear memory.)
    export tvm:memory/manager@0.1.0;
    export tvm:memory/bytes@0.1.0;
}
