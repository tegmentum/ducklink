package duckdb:component;

use duckdb:extension/config@5.0.0;
use duckdb:extension/logging@5.0.0;
use duckdb:extension/runtime@5.0.0;
use duckdb:extension/types@5.0.0;
use duckdb:extension/callback-dispatch@5.0.0;
use wasi:cli/environment@0.2.6;
use wasi:cli/stdout@0.2.6;
use wasi:cli/stderr@0.2.6;
use wasi:filesystem/preopens@0.2.6;
use wasi:io/streams@0.2.6;

interface database {
    use types.{capabilitykind, columndef, duckerror, duckvalue, logicaltype};

    /// Column shape for a host-registered table function. Mirrors the
    /// per-column pair carried by the `columndef` record but named to make
    /// the `register-table-function` call site self-explanatory (the caller
    /// is declaring the schema of a synthetic table, not returning result
    /// columns).
    record column-descriptor {
        name: string,
        ty: logicaltype,
    }

    resource connection;
    type row = list<duckvalue>;

    record query-result { columns: list<columndef>, rows: list<row> }

    resource result-stream {
        schema: func() -> list<columndef>;
        next: func(max-rows: u32) -> result<option<list<row>>, duckerror>;
        close: func();
    }

    resource prepared-statement {
        parameter-count: func() -> u32;
        execute: func(params: list<duckvalue>) -> result<query-result, duckerror>;
    }

    resource appender {
        append-row: func(values: list<duckvalue>) -> result<_, duckerror>;
        flush: func() -> result<_, duckerror>;
        close: func() -> result<_, duckerror>;
    }

    open: func(path: option<string>) -> result<connection, string>;
    open-with-config: func(path: option<string>, options: list<tuple<string, string>>) -> result<connection, string>;
    close: func(conn: connection);
    interrupt: func(conn: borrow<connection>);
    execute: func(conn: borrow<connection>, sql: string) -> result<query-result, duckerror>;
    open-stream: func(conn: borrow<connection>, sql: string) -> result<result-stream, duckerror>;
    prepare: func(conn: borrow<connection>, sql: string) -> result<prepared-statement, duckerror>;
    query-arrow: func(conn: borrow<connection>, sql: string) -> result<list<u8>, duckerror>;
    create-appender: func(conn: borrow<connection>, schema: option<string>, table: string) -> result<appender, duckerror>;
    register-extension: func(name: string, requires: list<capabilitykind>) -> result<bool, string>;
    list-registered-extensions: func() -> list<extension-info>;

    record extension-info { name: string, requires: list<capabilitykind> }

    record ui-response { status: u16, headers: string, body: list<u8> }

    handle-ui-request: func(method: string, path: string, headers: string, body: list<u8>) -> option<ui-response>;
    handle-quack-request: func(body: list<u8>) -> option<list<u8>>;

    /// Register a zero-argument table function on this database instance.
    /// Backs the Phase 2 (@5) ATTACH lift: the host reads `<alias>.<table>`
    /// column shapes via `storage-dispatch.table-columns`, mints a callback
    /// handle in its own registry, and calls this to graft an in-catalog
    /// name (e.g. `__mydb_foo`) that the host later fronts with a plain
    /// `CREATE VIEW mydb.foo AS SELECT * FROM __mydb_foo()`.
    ///
    /// When DuckDB executes the table function, the core drives the
    /// existing `callback-dispatch.call-table(callback-handle, args)` import
    /// with the supplied `callback-handle` (bind phase) and the streaming
    /// scan callbacks it registered internally (same C-API trampolines as
    /// extension-declared table functions -- see the precedent on
    /// `extension-loader-hooks.table-registration`).
    ///
    /// `columns` gives the table's schema; the arity must be >= 1. Returns
    /// `err(message)` when the underlying `duckdb_register_table_function`
    /// fails (name collision, invalid type, etc.) so the host can surface
    /// the message on the intercepting ATTACH.
    register-table-function: func(
        conn: borrow<connection>,
        name: string,
        columns: list<column-descriptor>,
        callback-handle: u32,
    ) -> result<_, string>;
}

interface host-extension-loader {
    request-load: func(name: string) -> bool;
}

interface extension-loader-hooks {
    use types.{logicaltype, columndef, funcflags};

    record func-arg { name: option<string>, logical: logicaltype }
    record func-opts { description: option<string>, tags: list<string>, attributes: funcflags }
    record ext-opts { description: option<string>, tags: list<string> }

    record scalar-registration {
        name: string,
        arguments: list<func-arg>,
        returns: logicaltype,
        callback-handle: u32,
        options: option<func-opts>,
    }

    record table-registration {
        name: string,
        arguments: list<func-arg>,
        columns: list<columndef>,
        callback-handle: u32,
        options: option<ext-opts>,
    }

    record aggregate-registration {
        name: string,
        arguments: list<func-arg>,
        returns: logicaltype,
        callback-handle: u32,
        options: option<func-opts>,
    }

    record macro-registration {
        schema: string,
        name: string,
        parameters: list<string>,
        definition-sql: string,
    }

    record replacement-scan-registration {
        extensions: list<string>,
        function-name: string,
    }

    record logical-type-registration {
        name: string,
        physical: string,
    }

    record cast-registration {
        source: string,
        target: string,
        callback-handle: u32,
    }

    record pending-registrations {
        scalars: list<scalar-registration>,
        tables: list<table-registration>,
        aggregates: list<aggregate-registration>,
        macros: list<macro-registration>,
        replacement-scans: list<replacement-scan-registration>,
        logical-types: list<logical-type-registration>,
        casts: list<cast-registration>,
    }

    get-pending-registrations: func() -> pending-registrations;
}

world libduckdb {
    import wasi:cli/environment@0.2.6;
    import wasi:cli/stdout@0.2.6;
    import wasi:cli/stderr@0.2.6;
    import wasi:filesystem/preopens@0.2.6;
    import wasi:filesystem/types@0.2.6;
    import wasi:io/streams@0.2.6;
    import host-extension-loader;
    import extension-loader-hooks;
    import duckdb:extension/callback-dispatch@5.0.0;
    import tvm:memory/manager@0.1.0;
    import tvm:memory/bytes@0.1.0;

    export database;
    export duckdb:extension/config@5.0.0;
    export duckdb:extension/logging@5.0.0;
    export duckdb:extension/runtime@5.0.0;
}
